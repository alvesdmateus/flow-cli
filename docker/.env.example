# =============================================================================
# flow-cli Docker Environment Configuration
# Copy to .env and customize as needed
# =============================================================================

# -----------------------------------------------------------------------------
# Build Configuration
# -----------------------------------------------------------------------------
VERSION=dev
COMMIT=none
BUILD_DATE=unknown

# -----------------------------------------------------------------------------
# LLM Configuration
# -----------------------------------------------------------------------------
# Provider: ollama, openai-compatible, localai, lmstudio, vllm, textgen, openai
FLOW_LLM_PROVIDER=ollama

# Endpoint URL (default for bundled Ollama)
FLOW_LLM_ENDPOINT=http://localhost:11434

# Default model to use (leave empty for interactive selection)
# Popular options: llama3.2, codellama, deepseek-coder, qwen2.5-coder
FLOW_LLM_MODEL=

# Temperature for LLM responses (0.0-1.0)
FLOW_LLM_TEMPERATURE=0.7

# -----------------------------------------------------------------------------
# Ollama Configuration
# -----------------------------------------------------------------------------
# Port to expose Ollama API
OLLAMA_PORT=11434

# Startup timeout in seconds (increase for slow systems)
OLLAMA_STARTUP_TIMEOUT=120

# Auto-pull the default model if not present
FLOW_AUTO_PULL_MODEL=true

# Models to preload on container start (space-separated)
# Example: FLOW_PRELOAD_MODELS=llama3.2 codellama:7b
FLOW_PRELOAD_MODELS=

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------
# Auto-approve all tool executions (not recommended for untrusted prompts)
FLOW_SECURITY_AUTO_APPROVE=false

# -----------------------------------------------------------------------------
# Search Configuration (optional)
# -----------------------------------------------------------------------------
# Enable web search capability
FLOW_SEARCH_ENABLED=false

# SearXNG endpoint (if using search profile)
FLOW_SEARCH_ENDPOINT=http://searxng:8080

# SearXNG external port
SEARXNG_PORT=8080

# -----------------------------------------------------------------------------
# Resource Limits
# -----------------------------------------------------------------------------
# Memory limit for containers (adjust based on model size)
# 7B models: 8G minimum, 16G recommended
# 13B models: 16G minimum, 24G recommended
# 70B models: 48G minimum (GPU recommended)
MEMORY_LIMIT=16G
MEMORY_RESERVATION=4G

# Ollama-specific limits (for sidecar mode)
OLLAMA_MEMORY_LIMIT=16G
OLLAMA_MEMORY_RESERVATION=4G

# -----------------------------------------------------------------------------
# Project Configuration
# -----------------------------------------------------------------------------
# Directory to mount as /data in the container
# This is where flow-cli will have access to your code
PROJECT_DIR=.

# -----------------------------------------------------------------------------
# GPU Configuration (for GPU profiles)
# -----------------------------------------------------------------------------
# These are typically set automatically by NVIDIA Container Toolkit
# NVIDIA_VISIBLE_DEVICES=all
# CUDA_VISIBLE_DEVICES=0
